#!/bin/bash
# Update VideoFX (and optionally the OS) with the read-only root in mind.
#
#   sudo videofx-update                        latest GitHub release of pi/
#   sudo videofx-update --tag v0.3.0           a given release
#   sudo videofx-update --tarball FILE         a videofx-pi-X.Y.Z.tar.gz copied over SSH, with FILE.sigstore.json
#                                              next to it (no GitHub API needed; Sigstore, apt and npm still are)
#   sudo videofx-update --tarball FILE --bundle B  the attestation bundle somewhere else
#   sudo videofx-update --tarball FILE --no-verify   your own unsigned build (only with --tarball)
#   sudo videofx-update --os                   also apt full-upgrade
#   sudo videofx-update --rollback             back to the previous version (/opt/videofx.prev)
#   sudo videofx-update --check                only check GitHub; the web page then shows "update available"
#
# If the root is protected (overlay), it records what to do on the data
# partition, switches to maintenance mode and reboots; videofx-update-resume.service
# carries on after the reboot, then switches protection back on and reboots again.
# If installing the new version fails (no network for apt or npm, say), the
# previous version is put back and protection is still switched back on.
# Every tarball must carry a GitHub build attestation (<tarball>.sigstore.json, made by
# this repo's CI on a release tag), checked with the installed version's
# videofx-verify-release before it is unpacked. Releases without one are not offered.
# The repo is private for now: put a GitHub token (read access to the repo's
# contents) in /srv/videofx/update/github-token, mode 600.
set -euo pipefail

APP=/opt/videofx
PREV=/opt/videofx.prev
WORK=/srv/videofx/update
[ -d /srv/videofx ] || WORK=/var/lib/videofx-update # no data partition: root is writable anyway
TOKEN=$WORK/github-token
CHECK_OUT=/var/lib/videofx/update-check.json
PENDING=$WORK/pending

die() {
  LAST_ERROR=$*
  echo "videofx-update: $*" >&2
  exit 1
}
protected() { [ "$(findmnt -no FSTYPE /)" = overlay ]; }
service_user() { stat -c %U /var/lib/videofx 2>/dev/null || getent passwd 1000 | cut -d: -f1; }
current_version() { node -e 'console.log(require(process.argv[1]).version)' "$APP/package.json" 2>/dev/null || echo 0.0.0; }

MODE=update TAG="" TARBALL="" BUNDLE="" VERIFY=1 EXPLICIT=0 OS=0 FAILED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) TAG=$2; shift ;;
    --tarball) TARBALL=$2; shift ;;
    --bundle) BUNDLE=$2; shift ;;
    --no-verify) VERIFY=0 ;;
    --os) OS=1 ;;
    --rollback) MODE=rollback ;;
    --check) MODE=check ;;
    --resume) MODE=resume ;;
    -h | --help) sed -n '2,24p' "$0"; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
  shift
done

if [ "$MODE" = check ]; then
  node "$APP/src/update-cli.js" check --token-file "$TOKEN" --out "$CHECK_OUT" --current "$(current_version)"
  exit 0
fi

# A named release or tarball may be older than what is installed (on purpose); a plain
# update (the web page's Upgrade button) only ever moves forward.
[ -z "$TAG$TARBALL" ] || EXPLICIT=1
[ "$VERIFY" = 1 ] || [ -n "$TARBALL" ] || die "--no-verify only goes with --tarball (GitHub releases are always checked)"
[ "$(id -u)" -eq 0 ] || die "run with sudo"
install -d -m 700 "$WORK"

# The journal is in RAM and an update reboots, so a run also logs to the data
# partition: $LOG (this run; a resumed run appends, the run before is $LOG.1) and,
# for the web page, update-last.json (state, reason, the end of the log).
LOG=$WORK/last.log
LAST_OUT=/var/lib/videofx/update-last.json
LAST_ERROR=""
if [ "$MODE" = resume ]; then
  [ -f "$PENDING" ] || exit 0
else
  [ ! -f "$LOG" ] || mv -f "$LOG" "$LOG.1"
fi
exec > >(tee -a "$LOG") 2>&1
echo "== videofx-update $MODE, $(date '+%F %T %Z'), installed $(current_version)"
record() { # state [message]
  [ -d "$(dirname "$LAST_OUT")" ] || return 0
  node "$APP/src/update-cli.js" result --out "$LAST_OUT" --state "$1" --message "${2:-}" --current "$(current_version)" --log "$LOG" 2>/dev/null || true
}

# Protected root: park the job on the data partition, reboot writable, resume.
park_and_reboot() {
  {
    printf 'MODE=%q\nTAG=%q\nOS=%q\nVERIFY=%q\nEXPLICIT=%q\nRESTORE_PROTECTION=1\n' "$MODE" "$TAG" "$OS" "$VERIFY" "$EXPLICIT"
  } >"$PENDING"
  sync
  /usr/local/sbin/videofx-maint on
  echo "Rebooting into maintenance mode; the update continues after the reboot (log: $LOG)."
  record running "rebooting into maintenance mode; the update continues after the reboot"
  systemctl reboot
  exit 0
}

finish() {
  FINISHED=1
  local what=Done
  [ "$FAILED" = 0 ] || what="The update FAILED and the previous version was put back"
  rm -f "$PENDING"
  if [ "$FAILED" = 0 ]; then record "done" "$what: $(current_version) installed"; else record failed "$what"; fi
  sync
  if [ "${RESTORE_PROTECTION:-0}" = 1 ]; then
    /usr/local/sbin/videofx-maint off
    echo "$what; rebooting with protection back on."
    systemctl reboot
  else
    systemctl restart videofx-player.service
    echo "$what."
  fi
  [ "$FAILED" = 0 ] || exit 1
}

# The unit file that belongs to the version now in $APP.
install_unit() {
  [ -f "$APP/system/videofx-player.service" ] || return 0
  # Renders the unit for the service account and reloads systemd. Rolling back to a
  # version older than videofx-user leaves the installed unit as it is.
  local render=/usr/local/sbin/videofx-user
  [ -x "$render" ] || render=$APP/system/videofx-user
  [ -x "$render" ] || return 0
  "$render" "$(service_user)" "$APP/system/videofx-player.service"
}

do_update() {
  local tarball=$WORK/release.tar.gz src advertised="" newv attested=""
  if [ ! -s "$tarball" ]; then
    echo "== fetching the release from GitHub"
    local meta url bundle_url
    meta=$(node "$APP/src/update-cli.js" latest --token-file "$TOKEN" ${TAG:+--tag "$TAG"})
    url=$(node -e 'console.log(JSON.parse(process.argv[1]).url)' "$meta")
    bundle_url=$(node -e 'console.log(JSON.parse(process.argv[1]).bundleUrl)' "$meta")
    advertised=$(node -e 'console.log(JSON.parse(process.argv[1]).version)' "$meta")
    node "$APP/src/update-cli.js" download --token-file "$TOKEN" --url "$url" --out "$tarball"
    node "$APP/src/update-cli.js" download --token-file "$TOKEN" --url "$bundle_url" --out "$tarball.sigstore.json"
  fi
  if [ "$VERIFY" = 1 ]; then
    # The installed version's verifier, never anything from the new tarball.
    [ -f "$APP/src/verify-release.js" ] || die "the installed version has no src/verify-release.js; update with --tarball FILE --no-verify once"
    if ! attested=$(bash "$APP/system/videofx-verify-release" "$tarball" "$tarball.sigstore.json" "$WORK/sigstore-tuf"); then
      rm -f "$tarball" "$tarball.sigstore.json"
      die "the release's GitHub attestation does not check out; nothing was installed"
    fi
    echo "== attestation OK: built by GitHub Actions for $attested"
  else
    echo "== WARNING: --no-verify, installing an unsigned tarball"
  fi
  rm -rf "$WORK/new"
  mkdir -p "$WORK/new"
  tar -xzf "$tarball" -C "$WORK/new"
  src=$(dirname "$(find "$WORK/new" -maxdepth 2 -name package.json | head -1)")
  [ -f "$src/package.json" ] && [ -f "$src/system/setup.sh" ] || die "not a VideoFX release tarball"
  [ "$(node -e 'console.log(require(process.argv[1]).name)' "$src/package.json")" = videofx ] || die "tarball is not VideoFX"
  # The attestation covers the bytes: an old attested tarball attached to a new release
  # would otherwise install a known-vulnerable version. Bind it to the tag CI built it
  # for and to the release, and never go backwards unless a release or tarball was
  # named on the command line.
  newv=$(node -e 'console.log(require(process.argv[1]).version)' "$src/package.json")
  [ -z "${attested:-}" ] || [ "$attested" = "v$newv" ] || die "the tarball holds $newv but was built for $attested; nothing was installed"
  [ -z "$advertised" ] || [ "$newv" = "$advertised" ] || die "the release says $advertised but its tarball holds $newv; nothing was installed"
  if ! node -e 'import(process.argv[1]).then((m) => process.exit(m.compareVersions(process.argv[2], process.argv[3]) > 0 ? 0 : 1))' "$APP/src/update.js" "$newv" "$(current_version)"; then
    [ "$EXPLICIT" = 1 ] || die "$newv is not newer than the installed $(current_version); name it with --tag or --tarball to go back on purpose"
    echo "== WARNING: $newv is not newer than the installed $(current_version) (asked for by name)"
  fi
  echo "== $(current_version) -> $(node -e 'console.log(require(process.argv[1]).version)' "$src/package.json")"

  systemctl stop videofx-player.service || true
  rm -rf "$PREV"
  cp -a "$APP" "$PREV" # with node_modules, so a rollback works offline
  # app, npm ci --omit=dev, units, config. It replaces $APP as it goes (npm ci
  # empties node_modules first), so a failure half-way leaves nothing that runs:
  # put the previous version back.
  if ! "$src/system/setup.sh" "$(service_user)" "$src"; then
    echo "videofx-update: installing the new version failed; putting $(node -e 'console.log(require(process.argv[1]).version)' "$PREV/package.json" 2>/dev/null || echo "the previous version") back" >&2
    rm -rf "$APP"
    cp -a "$PREV" "$APP"
    install_unit
    FAILED=1
  elif [ "$OS" = 1 ]; then
    echo "== OS: apt full-upgrade"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade
  fi
  rm -rf "$WORK/new" "$tarball" "$tarball.sigstore.json"
}

do_rollback() {
  [ -d "$PREV" ] || die "no previous version in $PREV"
  systemctl stop videofx-player.service || true
  mv "$APP" "$APP.bad"
  mv "$PREV" "$APP"
  mv "$APP.bad" "$PREV"
  install_unit
  echo "== rolled back to $(current_version) (the other version is now in $PREV)"
}

# A resumed job that stops early (a refused signature or version, a failed download:
# die or set -e) must not leave the Pi in maintenance mode with a writable root.
on_exit() {
  local code=$?
  [ "$code" -ne 0 ] && [ "${FINISHED:-0}" = 0 ] || return 0
  record stopped "${LAST_ERROR:-stopped with exit code $code; see the log}"
  [ "${RESTORE_PROTECTION:-0}" = 1 ] || return 0
  echo "videofx-update: stopped (exit $code); switching protection back on and rebooting" >&2
  rm -f "$PENDING" "$WORK/release.tar.gz" "$WORK/release.tar.gz.sigstore.json"
  sync
  /usr/local/sbin/videofx-maint off || true
  systemctl reboot || true
}
trap on_exit EXIT

case "$MODE" in
  resume)
    [ -f "$PENDING" ] || exit 0
    # shellcheck source=/dev/null
    . "$PENDING"
    mv "$PENDING" "$PENDING.running" # never loop on a failing update
    PENDING=$PENDING.running
    record running "resumed after the maintenance reboot"
    if [ "$MODE" = rollback ]; then do_rollback; else do_update; fi
    finish
    ;;
  update)
    rm -f "$WORK/release.tar.gz" "$WORK/release.tar.gz.sigstore.json"
    # A plain update only moves forward: ask GitHub first, so an up-to-date Pi is not
    # rebooted twice for nothing (and a network failure changes nothing).
    if [ -z "$TAG$TARBALL" ] && [ "$OS" = 0 ]; then
      meta=$(node "$APP/src/update-cli.js" latest --token-file "$TOKEN") ||
        die "could not ask GitHub for the latest release; nothing was changed"
      latest=$(node -e 'console.log(JSON.parse(process.argv[1]).version)' "$meta")
      if ! node -e 'import(process.argv[1]).then((m) => process.exit(m.compareVersions(process.argv[2], process.argv[3]) > 0 ? 0 : 1))' "$APP/src/update.js" "$latest" "$(current_version)"; then
        echo "Already up to date ($(current_version); the latest release is $latest). Nothing to do."
        record up-to-date "already up to date; the latest release is $latest"
        exit 0
      fi
      echo "== $(current_version) -> $latest"
    fi
    record running "updating from $(current_version)"
    if [ -n "$TARBALL" ]; then
      install -m 600 "$TARBALL" "$WORK/release.tar.gz"
      if [ "$VERIFY" = 1 ]; then
        [ -f "${BUNDLE:-$TARBALL.sigstore.json}" ] || die "no attestation: expected ${BUNDLE:-$TARBALL.sigstore.json} (or --bundle FILE)"
        install -m 600 "${BUNDLE:-$TARBALL.sigstore.json}" "$WORK/release.tar.gz.sigstore.json"
      fi
    fi
    protected && park_and_reboot
    do_update
    finish
    ;;
  rollback)
    record running "rolling back from $(current_version)"
    protected && park_and_reboot
    do_rollback
    finish
    ;;
esac
