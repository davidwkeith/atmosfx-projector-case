# Installed by setup.sh, which replaces User= with the login user.
[Unit]
Description=VideoFX player (Matter device driving mpv, projector power, web UI)
Wants=network-online.target
After=network-online.target sound.target videofx-hostname.service videofx-storage.service
# Settings, pairing and videos live on the data partition (bind mounts).
RequiresMountsFor=/var/lib/videofx MEDIA_DIR

[Service]
# notify: READY=1 once start-up is done (not tied to the network), then WATCHDOG=1 from the main loop.
# The pings come from a short-lived systemd-notify, hence NotifyAccess=all.
Type=notify
NotifyAccess=all
WatchdogSec=30
TimeoutStartSec=120
User=pi
# DRM/KMS output, hardware decode, CEC and IR (video), ALSA, tty1 for the
# black/pairing screen, and GPIO (PIR, relay).
SupplementaryGroups=video render audio tty gpio
# Web UI on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=-/etc/default/videofx
WorkingDirectory=/opt/videofx
ExecStart=/usr/bin/node /opt/videofx/src/main.js
# After any stop (crash, kill, watchdog, update): relay open, so a relay-switched
# projector is never left powered with nothing watching its temperature.
# "+": as root. Reads VIDEOFX_RELAY_GPIO / _ACTIVE_LOW from the EnvironmentFile.
ExecStopPost=+/usr/local/sbin/videofx-relay-open
# Matter fabrics and last on/off state: /var/lib/videofx (exported as $STATE_DIRECTORY).
StateDirectory=videofx
StateDirectoryMode=0700
# /run/videofx: mpv's IPC socket.
RuntimeDirectory=videofx
RuntimeDirectoryMode=0700
# always: also after "Reset Matter pairing", which exits cleanly.
Restart=always
RestartSec=5
# SIGTERM to node only; it stops mpv itself, then systemd cleans up the rest.
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
# The service runs as the login user; it (and mpv) only ever write the media
# folder and /var/lib/videofx, never the rest of the home folder (SSH keys...).
ProtectHome=read-only
ReadWritePaths=-MEDIA_DIR

[Install]
WantedBy=multi-user.target
