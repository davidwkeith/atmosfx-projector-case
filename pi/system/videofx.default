# /etc/default/videofx - settings for videofx-player.service (generated by tools/gen-default.mjs).
#
# Almost everything here can also be changed on the web page (Settings), which
# saves to /var/lib/videofx/settings.json. A value set on the web page WINS over
# this file; the page's Reset goes back to this file, then to the default.
# Precedence: web page > this file > built-in default. Lines are commented out,
# so the defaults apply until you set them.
#
# systemd reads this file, not a shell. Put a value that contains quotes (the
# JSON ones) in single quotes, as the examples do: quotes inside an unquoted
# value are dropped, and the setting then falls back to its default.
#
# After editing: sudo systemctl restart videofx-player
# Root-only (mode 600) because it can hold the web page password.


# --- Device
# Device name. Shown in Matter controllers and on this page. Up to 32 characters.
#VIDEOFX_NAME=VideoFX-XXXX
# After a power cut. last: as it was; on: always play; off: always stay off.
#VIDEOFX_RESTORE=last

# --- Web page
# Password. HTTP basic auth, any user name. Plain HTTP on your LAN, not HTTPS.
#VIDEOFX_WEB_PASSWORD=
# Extra host names. Other names this page answers to, e.g. a UniFi local DNS record. Space separated.
#VIDEOFX_WEB_HOSTS=
# Largest upload (MB)
#VIDEOFX_MAX_UPLOAD_MB=4096

# --- Audio
# Volume (%). The slider above sets this too. The file value is only the starting level.
#VIDEOFX_VOLUME_DEFAULT=30
# ALSA card name (applies on the next play). Card by name, never by number. Raspberry Pi DigiAMP+: RPiDigiAMP (aplay -l shows it as "RPi DigiAMP+").
#VIDEOFX_AUDIO_CARD=RPiDigiAMP
# Mixer control (applies on the next play). Hardware volume control on the card. DigiAMP+: Digital.
#VIDEOFX_MIXER_CONTROL=Digital

# --- Display
# Video output (DRM connector) (applies on the next play). HDMI-A-1 is the only HDMI port on a Pi 3 / Zero 2 W, and HDMI0 (next to USB-C) on a Pi 4B / 5. Empty lets mpv choose.
#VIDEOFX_VIDEO_OUTPUT=HDMI-A-1

# --- Projector
# Projector power. cec: HDMI-CEC wake/standby (falls back to hdmi-off if the projector never answers). relay-ir: relay on the DC feed, then the IR power code. relay: relay only, for projectors that switch on by themselves. hdmi-off: turn the HDMI signal off when stopped. none: leave it alone.
#VIDEOFX_PROJECTOR_POWER=cec
# Relay settle time (s). relay / relay-ir: wait this long after power-up before sending IR and starting playback.
#VIDEOFX_RELAY_SETTLE_SEC=3
# IR power code. protocol:scancode (e.g. nec:0x40bf) or raw:+9000 -4500 ... Learn it with the receiver, or paste it.
#VIDEOFX_IR_POWER_CODE=
# Projector needs two power presses
#VIDEOFX_IR_DOUBLE_PRESS=false
# CEC device. /dev/cec0 is HDMI0 (the only port on a Pi 3 / Zero 2 W).
#VIDEOFX_CEC_DEVICE=/dev/cec0

# --- Display
# Mirror (flip left-right). For rear projection onto window material. Uses more CPU: frames are flipped in software.
#VIDEOFX_MIRROR=false

# --- Advanced
# Extra mpv options (applies on the next play). --name=value options, space separated, added after the built-in ones (so they can override them), e.g. --hwdec=v4l2m2m-copy. Only decoding, DRM output, scaling, sync, cache and audio-timing options are accepted.
#VIDEOFX_MPV_EXTRA_ARGS=

# --- Playback
# Mode. loop: play the playlist over and over. scare: loop a calm clip and play a scare clip on a trigger.
#VIDEOFX_MODE=loop

# --- Scare
# Calm clip (loops between scares)
#VIDEOFX_SCARE_BUFFER=
# Scare clips. In /etc/default/videofx: a JSON list of file names in single quotes, e.g. '["ghost.mp4"]'.
#VIDEOFX_SCARE_CLIPS=[]
# Scare order
#VIDEOFX_SCARE_ORDER=sequential
# Cooldown after a scare (s). Triggers are ignored for this long after a scare ends.
#VIDEOFX_SCARE_COOLDOWN=20
# Trigger during a scare. ignore it, or queue one scare that plays when this one ends and the cooldown is over.
#VIDEOFX_SCARE_DURING_SCARE=ignore

# --- Motion sensor
# PIR motion sensor. Scares only fire when playback is on and the mode is scare. Also shown in Matter as an occupancy sensor.
#VIDEOFX_PIR=false
# PIR GPIO (BCM number). GPIO17 is physical pin 11. The DigiAMP+ uses GPIO 2, 3, 4, 18-21 and 22.
#VIDEOFX_PIR_GPIO=17
# PIR debounce (ms)
#VIDEOFX_PIR_DEBOUNCE_MS=50

# --- Schedule
# Latitude. For sunset. Degrees, north positive. Two decimals are plenty.
#VIDEOFX_LATITUDE=
# Longitude. Degrees, east positive (west is negative).
#VIDEOFX_LONGITUDE=
# Weekly schedule. In /etc/default/videofx: JSON, in single quotes.
#VIDEOFX_SCHEDULE='{"enabled":false,"sunsetOffsetMin":0,"days":{"sun":{"on":"","off":""},"mon":{"on":"","off":""},"tue":{"on":"","off":""},"wed":{"on":"","off":""},"thu":{"on":"","off":""},"fri":{"on":"","off":""},"sat":{"on":"","off":""}}}'

# --- Cooling
# Fans and temperature protection. Turn on once the fans and DS18B20 sensors are wired, and choose the projector-zone sensor: with no reading from it for 60 s while playing, playback stops. Off: the fans run flat out and nothing is protected.
#VIDEOFX_THERMAL=false
# Projector fan curve (°C:duty%). Linear between points, e.g. 30:25 40:50 50:100.
#VIDEOFX_FAN1_CURVE=30:25 40:50 50:100
# Pi/brick fan curve (°C:duty%). Follows the hotter of the Pi-zone sensor and the SoC.
#VIDEOFX_FAN2_CURVE=45:25 60:60 70:100
# Minimum fan duty while the projector is on (%)
#VIDEOFX_FAN_MIN_DUTY=30
# Projector fan run-on after power-off (s)
#VIDEOFX_FAN_COOLDOWN_SEC=120
# Warning temperature (°C)
#VIDEOFX_TEMP_WARN_C=45
# Critical projector-zone temperature (°C). Stops playback and switches the projector off until it cools by the hysteresis.
#VIDEOFX_TEMP_CRIT_C=55
# Cool-down before resuming (°C below critical)
#VIDEOFX_TEMP_HYSTERESIS_C=5
# Projector-zone sensor (DS18B20 ROM ID)
#VIDEOFX_SENSOR_PROJECTOR=
# Pi-zone sensor (DS18B20 ROM ID)
#VIDEOFX_SENSOR_PI=

# --- DMX
# DMX (sACN / E1.31) control. While a source sends our universe, DMX controls power, mode, clip, volume, mute and dimmer.
#VIDEOFX_DMX=false
# Universe
#VIDEOFX_DMX_UNIVERSE=1
# Start address. 8 channels from here (1-505).
#VIDEOFX_DMX_ADDRESS=1
# Hold after the signal stops (s). Added to the 2.5 s sACN data-loss timeout before control goes back to Matter, the web page and the schedule.
#VIDEOFX_DMX_HOLD_SEC=5
# Accept multicast. Off: unicast only (recommended on Wi-Fi; send to this Pi's IP address).
#VIDEOFX_DMX_MULTICAST=true

# --- Schedule
# Quiet hours. In /etc/default/videofx: JSON, in single quotes.
#VIDEOFX_QUIET_HOURS='{"enabled":false,"volumeCap":10,"disableScares":true,"dmxBypass":false,"days":{"sun":{"start":"","end":""},"mon":{"start":"","end":""},"tue":{"start":"","end":""},"wed":{"start":"","end":""},"thu":{"start":"","end":""},"fri":{"start":"","end":""},"sat":{"start":"","end":""}}}'

# --- Web page
# Hide the Matter pairing code once paired. Anyone who can open this page could use the code while pairing mode is open.
#VIDEOFX_HIDE_PAIRING_WHEN_PAIRED=true

# --- Display
# Console for the black / pairing screen (needs a service restart). Empty disables it.
#VIDEOFX_CONSOLE=/dev/tty1

# --- File only (needs root, or would let the page point the service anywhere)
# The relay, IR and 1-wire pins are also in /boot/firmware/config.txt (the relay's
# boot level, the IR and w1-gpio overlays), written once by setup.sh with the
# defaults. Change them there too, or the new pins won't work.
# Relay GPIO (BCM)
#VIDEOFX_RELAY_GPIO=27
# Relay input is active-low
#VIDEOFX_RELAY_ACTIVE_LOW=true
# IR LED GPIO (BCM)
#VIDEOFX_IR_TX_GPIO=16
# IR LED driver
#VIDEOFX_IR_TX_DRIVER=gpio-ir-tx
# IR receiver GPIO (BCM)
#VIDEOFX_IR_RX_GPIO=23
# Projector fan PWM GPIO (hardware PWM0)
#VIDEOFX_FAN1_PWM_GPIO=12
# Pi/brick fan PWM GPIO (hardware PWM1)
#VIDEOFX_FAN2_PWM_GPIO=13
# Projector fan tach GPIO
#VIDEOFX_FAN1_TACH_GPIO=24
# Pi/brick fan tach GPIO
#VIDEOFX_FAN2_TACH_GPIO=25
# 1-wire (DS18B20) GPIO
#VIDEOFX_W1_GPIO=26
# Web page port
#VIDEOFX_HTTP_PORT=80
# Matter port
#VIDEOFX_MATTER_PORT=5540
# Media folder
#VIDEOFX_MEDIA_DIR=/home/pi/media
# Playlist file
#VIDEOFX_PLAYLIST=/home/pi/media/playlist.m3u
# mpv command
#VIDEOFX_MPV=mpv
# State folder
#VIDEOFX_STATE_DIR=/home/pi/.videofx
