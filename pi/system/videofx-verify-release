#!/bin/bash
# Check a release tarball against its GitHub build attestation.
#   videofx-verify-release TARBALL BUNDLE [TUF_CACHE]   -> the release tag (vX.Y.Z) on stdout
# Exit 0 only if BUNDLE (<tarball>.sigstore.json) is a Sigstore-signed build provenance
# attestation of TARBALL by this repo's build.yml on a release tag (src/verify-release.js).
# videofx-update runs the installed version's copy, never the one in the new tarball.
set -euo pipefail
[ $# -ge 2 ] && [ $# -le 3 ] || { echo "usage: videofx-verify-release TARBALL BUNDLE [TUF_CACHE]" >&2; exit 2; }
exec node "$(dirname "$(readlink -f "$0")")/../src/verify-release.js" "$1" "$2" ${3:+--tuf-cache "$3"}
